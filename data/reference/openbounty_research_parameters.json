  "battle": {
    "damage_model_reimplementation": "floor(count_at_turn_start * random_integer(melee_min,melee_max) * (attacker_skill + 5 - defender_skill) / 10); then adjust morale, artifacts, abilities and injury",
    "morale_damage_multipliers": {
      "L": 0.5,
      "N": 1,
      "H": 1.5
    },
    "morale_matrix_order": "row: subject troop group A..E; columns: other troop group A..E",
    "morale_matrix": [
      "NNNNN",
      "NNNNN",
      "NNHNN",
      "LNLHN",
      "LLLNN"
    ],
    "control_rule": "troop.hp * troop_count > leadership_current makes that stack out of control",
    "notes": [
      "Original manual and OpenBounty differ on some upkeep and morale handling; verify before asserting strict DOS fidelity.",
      "Ranged and special MAGIC damage require separate handling and are not described by the melee formula."
    ]
